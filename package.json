        "lucide-react": "^1.31.0",
        "next": "16.3.4",
        "next-themes": "^0.4.6",
        "pdfjs-dist": "6.5.438",
        "radix-ui": "^1.6.7",
        "react": "19.2.6",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.6",
        "react-hook-form": "^7.85.0",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "3.6.0",
        "three": "0.187.0",
        "vaul": "^1.1.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {

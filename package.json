{
    "name": "romly",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "install:ci": "node scripts/install-ci.mjs",
        "dev": "node scripts/run-framework.mjs dev",
        "build": "node scripts/run-framework.mjs build",
        "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
        "db:generate": "drizzle-kit generate",
        "test": "node --test tests/*.test.mjs",
        "check": "node --check public/studio/app.js && node --check public/studio/cloud.js && node --check public/studio/local-store.js && node --check public/studio/error-reporter.js && node --check public/studio/plan.js && node --check public/studio/plan-diff.js && node --check public/studio/reference-loader.js && node --check public/studio/scene-geometry.js && node --check public/studio/tek17-check.js && node --check public/studio/viewer3d.js && node --check scripts/build-studio-assets.mjs && node --check lib/projects-api.mjs && node --check scripts/deploy-cloudflare.mjs",
        "deploy:staging": "node scripts/deploy-cloudflare.mjs --env staging",
        "deploy:production": "node scripts/deploy-cloudflare.mjs --env production"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",

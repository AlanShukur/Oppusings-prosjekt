        "drizzle-kit": "0.31.10",
        "esbuild": "0.27.7",
        "eslint": "9.39.4",
        "eslint-config-next": "16.3.4",
        "json-rpc-2.0": "1.7.1",
        "raw-body": "3.0.2",
        "react-server-dom-webpack": "19.2.6",
        "tailwindcss": "4.2.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3",
